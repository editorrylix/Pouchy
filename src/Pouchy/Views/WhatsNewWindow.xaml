<Window x:Class="Pouchy.Views.WhatsNewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:views="clr-namespace:Pouchy.Views"
        Title="What's new in Pouchy"
        Width="600" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="True" WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Pouchy;component/Assets/pouchy.ico"
        FontFamily="{DynamicResource Pouch.FontFamily}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Grid Margin="24">
        <Border CornerRadius="{DynamicResource Pouch.CornerRadius}" Background="{DynamicResource Pouch.MenuBackground}"
                Effect="{DynamicResource Pouch.Shadow}"/>
        <Border CornerRadius="{DynamicResource Pouch.CornerRadius}" BorderThickness="1" BorderBrush="{DynamicResource Pouch.Border}" Padding="26,22,26,20">
            <StackPanel>
                <Grid Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <views:Mascot x:Name="HeroMascot" Width="60" Height="60" Margin="-4,-4,12,0" Mood="Idle"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="TitleText" FontFamily="{DynamicResource Pouch.HeaderFontFamily}" FontSize="19" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Pouch.Text}" TextWrapping="Wrap"/>
                        <TextBlock x:Name="SubtitleText" Margin="0,3,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource Pouch.TextSecondary}"/>
                    </StackPanel>
                    <Button Grid.Column="2" Style="{StaticResource PouchLinkButton}" Height="30" Padding="6,0" VerticalAlignment="Top"
                            ToolTip="Close (Esc)" Click="Close_Click">
                        <ui:SymbolIcon Symbol="Dismiss24" FontSize="14" Foreground="{DynamicResource Pouch.TextSecondary}"/>
                    </Button>
                </Grid>

                <Border Margin="0,16,0,0" Padding="16,12,8,12" CornerRadius="{DynamicResource Pouch.TileCornerRadius}"
                        Background="{DynamicResource Pouch.Tile}" BorderBrush="{DynamicResource Pouch.TileBorder}" BorderThickness="1">
                    <FlowDocumentScrollViewer x:Name="NotesViewer" MaxHeight="430" VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled" IsToolBarVisible="False" Focusable="False">
                        <FlowDocument x:Name="NotesDocument" PagePadding="0,0,18,0" FontSize="12.5" LineHeight="18" TextAlignment="Left"
                                      FontFamily="{DynamicResource Pouch.FontFamily}" Foreground="{DynamicResource Pouch.TextSecondary}"/>
                    </FlowDocumentScrollViewer>
                </Border>

                <DockPanel Margin="0,18,0,0">
                    <Button Style="{StaticResource PouchLinkButton}" Click="FullChangelog_Click">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="History24" FontSize="15" Margin="0,0,6,0" Foreground="{DynamicResource Pouch.Accent}"/>
                            <TextBlock Text="All versions" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Content="Got it" Style="{StaticResource PouchPrimaryButton}" IsDefault="True" HorizontalAlignment="Right" Click="Close_Click"/>
                </DockPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
