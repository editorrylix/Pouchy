<Window x:Class="Pouchy.Views.WelcomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:views="clr-namespace:Pouchy.Views"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=views:WelcomeModel}"
        Title="Welcome to Pouchy"
        Width="640" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="True" WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Pouchy;component/Assets/pouchy.ico"
        FontFamily="{DynamicResource Pouch.FontFamily}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <!-- One numbered step card. -->
        <Style x:Key="StepCard" TargetType="Border">
            <Setter Property="Margin" Value="0,0,10,10"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="CornerRadius" Value="{DynamicResource Pouch.TileCornerRadius}"/>
            <Setter Property="Background" Value="{DynamicResource Pouch.Tile}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Pouch.TileBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="StepNumber" TargetType="Border">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Background" Value="{DynamicResource Pouch.Accent}"/>
        </Style>
        <Style x:Key="StepTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource Pouch.Text}"/>
            <Setter Property="Margin" Value="0,2,0,3"/>
        </Style>
        <Style x:Key="StepText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="LineHeight" Value="16"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="{DynamicResource Pouch.TextSecondary}"/>
        </Style>
        <Style x:Key="OptionText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="{DynamicResource Pouch.Text}"/>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Border CornerRadius="{DynamicResource Pouch.CornerRadius}" Background="{DynamicResource Pouch.MenuBackground}"
                Effect="{DynamicResource Pouch.Shadow}"/>
        <Border CornerRadius="{DynamicResource Pouch.CornerRadius}" BorderThickness="1" BorderBrush="{DynamicResource Pouch.Border}" Padding="26,22,26,20">
            <StackPanel>
                <!-- Header -->
                <Grid Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <views:Mascot x:Name="HeroMascot" Width="72" Height="72" Margin="-6,-6,12,0" Mood="Idle"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Pouchy is ready!" FontFamily="{DynamicResource Pouch.HeaderFontFamily}" FontSize="21" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Pouch.Text}"/>
                        <TextBlock Margin="0,4,0,0" FontSize="12.5" TextWrapping="Wrap" Foreground="{DynamicResource Pouch.TextSecondary}"
                                   Text="It's a little shelf for your files, images, links and text. It's waiting in the system tray, next to the clock. Here's how to use it:"/>
                    </StackPanel>
                    <Button Grid.Column="2" Style="{StaticResource PouchLinkButton}" Height="30" Padding="6,0" VerticalAlignment="Top"
                            ToolTip="Close (Esc)" Click="Close_Click">
                        <ui:SymbolIcon Symbol="Dismiss24" FontSize="14" Foreground="{DynamicResource Pouch.TextSecondary}"/>
                    </Button>
                </Grid>

                <!-- The four steps -->
                <Grid Margin="0,20,-10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Style="{StaticResource StepCard}">
                        <DockPanel>
                            <Border Style="{StaticResource StepNumber}">
                                <TextBlock Text="1" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource Pouch.AccentText}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel>
                                <TextBlock Text="Grab a file and shake" Style="{StaticResource StepTitle}"/>
                                <TextBlock Style="{StaticResource StepText}"
                                           Text="Start dragging any file, then wiggle the mouse left and right. The pouch pops up next to it: let go to drop the file in."/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource StepCard}">
                        <DockPanel>
                            <Border Style="{StaticResource StepNumber}">
                                <TextBlock Text="2" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource Pouch.AccentText}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel>
                                <TextBlock Text="Open it any time" Style="{StaticResource StepTitle}"/>
                                <TextBlock Style="{StaticResource StepText}">
                                    <Run Text="Press"/>
                                    <Run Text="{Binding HotkeyText, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource Pouch.Text}"/><Run Text=", or click the Pouchy icon in the tray. Whatever you put in stays there, even after a restart."/>
                                </TextBlock>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <Border Grid.Row="1" Style="{StaticResource StepCard}">
                        <DockPanel>
                            <Border Style="{StaticResource StepNumber}">
                                <TextBlock Text="3" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource Pouch.AccentText}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel>
                                <TextBlock Text="Drag it out anywhere" Style="{StaticResource StepTitle}"/>
                                <TextBlock Style="{StaticResource StepText}"
                                           Text="Drag items from the pouch into any app or folder: an email, a chat, a website. Files are copied, so the originals stay where they were."/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource StepCard}">
                        <DockPanel>
                            <Border Style="{StaticResource StepNumber}">
                                <TextBlock Text="4" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource Pouch.AccentText}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel>
                                <TextBlock Text="Do more" Style="{StaticResource StepTitle}"/>
                                <TextBlock Style="{StaticResource StepText}">
                                    <Run Text="Right-click an item for actions, press"/>
                                    <Run Text="Ctrl&#160;+&#160;K" FontWeight="SemiBold" Foreground="{DynamicResource Pouch.Text}"/>
                                    <Run Text="in the pouch to find anything, and"/>
                                    <Run Text="{Binding ScreenshotText, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource Pouch.Text}"/>
                                    <Run Text="puts a screenshot in the pouch."/>
                                </TextBlock>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </Grid>

                <!-- A few choices -->
                <TextBlock Text="A few choices (you can change them later in Settings)" Margin="2,10,0,8" FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource Pouch.TextSecondary}"/>
                <Border CornerRadius="{DynamicResource Pouch.TileCornerRadius}" Padding="14,4" Background="{DynamicResource Pouch.Tile}"
                        BorderBrush="{DynamicResource Pouch.TileBorder}" BorderThickness="1">
                    <StackPanel>
                        <DockPanel Margin="0,6">
                            <ui:ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding StartWithWindows}"/>
                            <TextBlock Style="{StaticResource OptionText}" Text="Start Pouchy when Windows starts, so it's always ready"/>
                        </DockPanel>
                        <DockPanel Margin="0,6">
                            <ui:ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding ExplorerMenu}"/>
                            <TextBlock Style="{StaticResource OptionText}" Text="Add &#x201C;Add to Pouchy&#x201D; when you right-click files in File Explorer"/>
                        </DockPanel>
                        <DockPanel Margin="0,6">
                            <ui:ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding ClipboardHistory}"/>
                            <TextBlock Style="{StaticResource OptionText}" Text="Keep a history of what I copy (password managers are skipped)"/>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- Buttons -->
                <DockPanel Margin="0,18,0,0">
                    <Button Style="{StaticResource PouchLinkButton}" Click="Guide_Click" ToolTip="Opens the guide on GitHub">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="BookOpen24" FontSize="15" Margin="0,0,6,0" Foreground="{DynamicResource Pouch.Accent}"/>
                            <TextBlock Text="Read the full guide" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Close" Style="{StaticResource PouchButton}" Margin="0,0,8,0" Click="Close_Click"/>
                        <Button Style="{StaticResource PouchPrimaryButton}" IsDefault="True" Click="TryIt_Click">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Sparkle24" FontSize="14" Margin="0,0,6,0" Foreground="{DynamicResource Pouch.AccentText}"/>
                                <TextBlock Text="Show me the pouch" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </DockPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
