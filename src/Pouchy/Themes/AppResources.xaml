<!--
    Pouchy's own shared resources. Merged by App.xaml (and by the UI tests).
    WPF-UI's ThemesDictionary/ControlsDictionary must stay directly in App.xaml:
    its theme switcher only looks at the top level of the application resources.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:helpers="clr-namespace:Pouchy.Helpers">

    <!-- Fallbacks for the theme tokens menus and dialogs use. ThemeService writes the real values
         into the application resources at startup, which take precedence over these. -->
    <SolidColorBrush x:Key="Pouch.MenuBackground" Color="#FF1F1F26"/>
    <SolidColorBrush x:Key="Pouch.Text" Color="#FFF5F5F7"/>
    <SolidColorBrush x:Key="Pouch.TextSecondary" Color="#B3FFFFFF"/>
    <SolidColorBrush x:Key="Pouch.TextMuted" Color="#80FFFFFF"/>
    <SolidColorBrush x:Key="Pouch.TileHover" Color="#22FFFFFF"/>
    <SolidColorBrush x:Key="Pouch.TileBorder" Color="#24FFFFFF"/>

    <!-- WPF fades menus in and out using this system key. A menu caught mid-fade (for example when
         a screenshot tool takes focus) looks washed out, so Pouchy's menus pop in themselves instead. -->
    <PopupAnimation x:Key="{x:Static SystemParameters.MenuPopupAnimationKey}">None</PopupAnimation>

    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <helpers:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />
    <helpers:NullToVisibilityConverter x:Key="NullToVisibility" />
    <helpers:SymbolNameConverter x:Key="SymbolName" />

    <!-- ============================================================ Pouch context menus
         Themed with the pouch's tokens. Applied by Views/PouchWindow.Menus.cs. -->
    <Style x:Key="PouchContextMenu" TargetType="ContextMenu">
        <Setter Property="FontFamily" Value="{DynamicResource Pouch.FontFamily}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource Pouch.Text}"/>
        <Setter Property="HasDropShadow" Value="False"/>
        <Setter Property="Background" Value="{DynamicResource Pouch.MenuBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Pouch.TileBorder}"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <!-- Margin leaves room for the shadow inside the popup. The shadow is a separate
                         layer so the text isn't rendered through an Effect (which blurs it). -->
                    <Grid x:Name="MenuRoot" Margin="12" MinWidth="220" RenderTransformOrigin="0.5,0">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="MenuScale" ScaleX="1" ScaleY="1"/>
                        </Grid.RenderTransform>
                        <Border CornerRadius="10" Background="{TemplateBinding Background}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="20" ShadowDepth="5" Direction="270" Opacity="0.4"/>
                            </Border.Effect>
                        </Border>
                        <Border Padding="0,5" CornerRadius="10" BorderThickness="1" BorderBrush="{TemplateBinding BorderBrush}">
                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsOpen" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="MenuScale" Storyboard.TargetProperty="ScaleX" From="0.96" To="1" Duration="0:0:0.12"/>
                                        <DoubleAnimation Storyboard.TargetName="MenuScale" Storyboard.TargetProperty="ScaleY" From="0.92" To="1" Duration="0:0:0.12"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PouchMenuSeparator" TargetType="Separator">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Rectangle Height="1" Margin="10,4" Fill="{DynamicResource Pouch.TileBorder}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PouchMenuItem" TargetType="MenuItem">
        <Setter Property="Foreground" Value="{DynamicResource Pouch.Text}"/>
        <Setter Property="FontFamily" Value="{DynamicResource Pouch.FontFamily}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Grid>
                        <Border x:Name="Bd" Margin="4,0" Padding="8,6" CornerRadius="6" Background="Transparent">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="26"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="16"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter x:Name="IconHost" ContentSource="Icon" VerticalAlignment="Center" HorizontalAlignment="Left"
                                                  TextElement.Foreground="{DynamicResource Pouch.TextSecondary}"/>
                                <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{TemplateBinding InputGestureText}" Margin="24,0,0,0" FontSize="11"
                                           VerticalAlignment="Center" Foreground="{DynamicResource Pouch.TextMuted}"/>
                                <Path x:Name="Arrow" Grid.Column="3" Data="M0,0 L4,4 L0,8" Stroke="{DynamicResource Pouch.TextSecondary}"
                                      StrokeThickness="1.5" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                        <Popup x:Name="PART_Popup" Placement="Right" HorizontalOffset="-8" VerticalOffset="-14" AllowsTransparency="True"
                               Focusable="False" PopupAnimation="None"
                               IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}">
                            <Grid Margin="12" MinWidth="180" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
                                <Border CornerRadius="10" Background="{DynamicResource Pouch.MenuBackground}">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="20" ShadowDepth="5" Direction="270" Opacity="0.4"/>
                                    </Border.Effect>
                                </Border>
                                <Border Padding="0,5" CornerRadius="10" BorderThickness="1" BorderBrush="{DynamicResource Pouch.TileBorder}">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                </Border>
                            </Grid>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Role" Value="SubmenuHeader">
                            <Setter TargetName="Arrow" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Pouch.TileHover}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="IconHost" Property="TextElement.Foreground" Value="{DynamicResource Pouch.Accent}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Pouch.Accent}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- App name and a status line at the top of the tray menu. A Separator so it can't be clicked. -->
    <Style x:Key="PouchMenuHeader" TargetType="Separator">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Grid Margin="14,8,14,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Image Source="pack://application:,,,/Pouchy;component/Assets/pouchy-256.png" Width="28" Height="28" Margin="0,0,10,0"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Pouchy" FontFamily="{DynamicResource Pouch.HeaderFontFamily}" FontSize="13.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Pouch.Text}"/>
                            <TextBlock Text="{TemplateBinding Tag}" FontSize="11" Margin="0,1,0,0" Foreground="{DynamicResource Pouch.TextMuted}"/>
                        </StackPanel>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A square, icon-only entry for the icon and colour pickers (laid out in a grid). -->
    <Style x:Key="PouchMenuTile" TargetType="MenuItem">
        <Setter Property="Width" Value="36"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="Margin" Value="2"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Bd" CornerRadius="8" BorderThickness="2" BorderBrush="Transparent" Background="Transparent">
                        <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Pouch.TileHover}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Pouch.Accent}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Red text for destructive actions like "Delete from disk". -->
    <Style x:Key="PouchDangerMenuItem" TargetType="MenuItem" BasedOn="{StaticResource PouchMenuItem}">
        <Setter Property="Foreground" Value="{DynamicResource Pouch.Danger}"/>
    </Style>
    <!-- Buttons for the pouch-styled windows (welcome, what's new). -->
    <Style x:Key="PouchButton" TargetType="Button">
        <Setter Property="MinWidth" Value="84"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="Padding" Value="16,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource Pouch.Text}"/>
        <Setter Property="Background" Value="{DynamicResource Pouch.Tile}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Pouch.TileBorder}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border CornerRadius="9" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"/>
                        <Border x:Name="Hover" CornerRadius="9" Background="White" Opacity="0"/>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Hover" Property="Opacity" Value="0.1"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="PouchPrimaryButton" TargetType="Button" BasedOn="{StaticResource PouchButton}">
        <Setter Property="Background" Value="{DynamicResource Pouch.Accent}"/>
        <Setter Property="Foreground" Value="{DynamicResource Pouch.AccentText}"/>
    </Style>
    <Style x:Key="PouchLinkButton" TargetType="Button" BasedOn="{StaticResource PouchButton}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource Pouch.Accent}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Padding" Value="8,0"/>
        <Setter Property="MinWidth" Value="0"/>
    </Style>
</ResourceDictionary>
