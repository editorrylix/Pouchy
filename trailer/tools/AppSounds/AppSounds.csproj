<Project Sdk="Microsoft.NET.Sdk">
  <!-- Writes Pouchy's built-in interface sounds (SoundSynth) to WAV files for the trailer's mix. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\src\Pouchy\Pouchy.csproj" />
  </ItemGroup>
</Project>
