<ui:FluentWindow x:Class="Pouchy.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vm="clr-namespace:Pouchy.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}"
        Title="Pouchy Settings" Height="720" Width="560" MinWidth="460" MinHeight="400"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True"
        WindowCornerPreference="Round"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Pouchy;component/Assets/pouchy.ico"
        Closing="Window_Closing">

    <ui:FluentWindow.Resources>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="2,18,0,8"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
        </Style>
        <Style x:Key="CardDescription" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
        </Style>
        <Style TargetType="ui:CardControl" BasedOn="{StaticResource {x:Type ui:CardControl}}">
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Pouchy Settings"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20,0,20,20">

                <!-- Appearance -->
                <TextBlock Text="Theme" Style="{StaticResource SectionHeader}"/>
                <ListBox ItemsSource="{Binding Themes}" SelectedValuePath="Id" SelectedValue="{Binding SelectedThemeId}"
                         Background="Transparent" BorderThickness="0" Padding="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.Template>
                        <ControlTemplate TargetType="ListBox">
                            <ItemsPresenter/>
                        </ControlTemplate>
                    </ListBox.Template>
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Margin" Value="0,0,8,8"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Ring" CornerRadius="10" BorderThickness="2" BorderBrush="Transparent" Padding="2">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ThemeOption}">
                            <StackPanel Width="148">
                                <!-- Mini pouch preview -->
                                <Border Height="82" CornerRadius="8" Background="{Binding Background}" BorderBrush="{Binding Border}" BorderThickness="1" Padding="10,8">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                                            <Border Width="10" Height="10" CornerRadius="3" Background="{Binding Accent}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Pouchy" FontFamily="{Binding HeaderFont}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding Text}"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                                            <Border Width="30" Height="30" CornerRadius="{Binding CornerRadius}" Background="{Binding Tile}" Margin="0,0,5,0"/>
                                            <Border Width="30" Height="30" CornerRadius="{Binding CornerRadius}" Background="{Binding Tile}" Margin="0,0,5,0"/>
                                            <Border Width="30" Height="30" CornerRadius="{Binding CornerRadius}" Background="{Binding Accent}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <TextBlock Text="{Binding Name}" Margin="4,6,0,0" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Subtitle}" Margin="4,0,0,4" FontSize="10.5"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Style="{StaticResource CardDescription}" Margin="2,0,0,8"
                           Text="Customize a theme to change its colours, fonts and corners while you watch. Custom themes are JSON files in the themes folder, so they're easy to share."/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <ui:Button Content="Customize this theme" Icon="{ui:SymbolIcon Edit24}" Margin="0,0,8,0" Command="{Binding CustomizeThemeCommand}"/>
                    <ui:Button Content="Open themes folder" Icon="{ui:SymbolIcon FolderOpen24}" Command="{Binding OpenThemesFolderCommand}"/>
                </StackPanel>

                <ui:CardControl Margin="0,4,0,4">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Text="Show Pouchy the mascot" Style="{StaticResource CardTitle}"/>
                            <TextBlock Text="The little pouch in the header and empty pouch that reacts when you drop things." Style="{StaticResource CardDescription}"/>
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ui:ToggleSwitch IsChecked="{Binding ShowMascot}"/>
                </ui:CardControl>

                <TextBlock Text="Layout" Style="{StaticResource SectionHeader}"/>
                <ui:CardControl>
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Text="View" Style="{StaticResource CardTitle}"/>
                            <TextBlock Text="Grid shows thumbnails, List shows details, Compact fits the most items." Style="{StaticResource CardDescription}"/>
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ComboBox Width="130" ItemsSource="{Binding ViewModeOptions}" SelectedItem="{Binding ViewMode}"/>
                </ui:CardControl>
                <ui:CardControl>
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Text="Compact shelf tabs" Style="{StaticResource CardTitle}"/>
                            <TextBlock Text="Only the open shelf shows its name; the others show just their icon." Style="{StaticResource CardDescription}"/>
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ui:ToggleSwitch IsChecked="{Binding CompactShelfTabs}"/>
                </ui:CardControl>
                <ui:CardControl>
                    <ui:CardControl.Header>
                        <TextBlock Text="Tile size" Style="{StaticResource CardTitle}"/>
                    </ui:CardControl.Header>
                    <ComboBox Width="130" ItemsSource="{Binding TileSizeOptions}" SelectedItem="{Binding TileSize}"/>
                </ui:CardControl>
                <ui:CardControl>
                    <ui:CardControl.Header>
                        <TextBlock Style="{StaticResource CardTitle}">
                            <Run Text="Columns:"/>
                            <Run Text="{Binding GridColumns, Mode=OneWay}"/>
                        </TextBlock>
                    </ui:CardControl.Header>
                    <Slider Width="180" Minimum="2" Maximum="6" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding GridColumns}"/>
                </ui:CardControl>
                <ui:CardControl>
                    <ui:CardControl.Header>
                        <TextBlock Text="Show file names under tiles" Style="{StaticResource CardTitle}"/>
                    </ui:CardControl.Header>
                    <ui:ToggleSwitch IsChecked="{Binding ShowItemNames}"/>
                </ui:CardControl>
                <ui:CardControl>
                    <ui:CardControl.Header>
                        <TextBlock Text="Show size and type under tiles" Style="{StaticResource CardTitle}"/>
                    </ui:CardControl.Header>
                    <ui:ToggleSwitch IsChecked="{Binding ShowItemDetails}"/>
                </ui:CardControl>
                <ui:CardControl>
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}">
                                <Run Text="Background opacity:"/>
                                <Run Text="{Binding BackgroundOpacity, Mode=OneWay, StringFormat={}{0:P0}}"/>
                            </TextBlock>
                            <TextBlock Text="Lower values let more of the desktop show through." Style="{StaticResource CardDescription}"/>
                        </StackPanel>
                    </ui:CardControl.Header>
                    <Slider Width="180" Minimum="0.4" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True" Value="{Binding BackgroundOpacity}"/>
                </ui:CardControl>

                <TextBlock Text="Motion" Style="{StaticResource SectionHeader}"/>
                <ui:CardControl>
                    <ui:CardControl.Header>
                        <TextBlock Text="Open animation" Style="{StaticResource CardTitle}"/>
                    </ui:CardControl.Header>
                    <ComboBox Width="130" ItemsSource="{Binding SpawnAnimationOptions}" SelectedItem="{Binding SpawnAnimation}"/>
                </ui:CardControl>
                <ui:CardControl>
                    <ui:CardControl.Header>
                        <TextBlock Style="{StaticResource CardTitle}">
                            <Run Text="Animation speed:"/>
                            <Run Text="{Binding AnimationSpeed, Mode=OneWay, StringFormat={}{0:0.##}x}"/>
                        </TextBlock>
                    </ui:CardControl.Header>
                    <Slider Width="180" Minimum="0.5" Maximum="2" TickFrequency="0.25" IsSnapToTickEnabled="True" Value="{Binding AnimationSpeed}"/>
                </ui:CardControl>
                <ui:CardControl>
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Text="Reduce motion" Style="{StaticResource CardTitle}"/>
                            <TextBlock Text="Turn off all animations." Style="{StaticResource CardDescription}"/>
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ui:ToggleSwitch IsChecked="{Binding ReduceMotion}"/>
                </ui:CardControl>

                <!-- Dragging out -->
                <TextBlock Text="Dragging out" Style="{StaticResource SectionHeader}"/>
                <ui:CardControl>
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Text="When you drop files somewhere" Style="{StaticResource CardTitle}"/>
                            <TextBlock Text="Copy keeps the originals where they are (hold Shift to move). Move works like Explorer (hold Ctrl to copy)."
                                       Style="{StaticResource CardDescription}"/>
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ComboBox Width="130" ItemsSource="{Binding DragOutOptions}" SelectedItem="{Binding DragOutAction}"/>
                </ui:CardControl>
                <ui:CardControl>
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Text="Remove items after dragging them out" Style="{StaticResource CardTitle}"/>
                            <TextBlock Text="Pinned or not, an item leaves the pouch once you've dropped it somewhere." Style="{StaticResource CardDescription}"/>
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ui:ToggleSwitch IsChecked="{Binding RemoveAfterDragOut}"/>
                </ui:CardControl>

                <!-- General -->
                <TextBlock Text="General" Style="{StaticResource SectionHeader}"/>
                <ui:CardControl>
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Text="Run at Windows startup" Style="{StaticResource CardTitle}"/>
                            <TextBlock Text="Start Pouchy in the tray when you sign in." Style="{StaticResource CardDescription}"/>
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ui:ToggleSwitch IsChecked="{Binding RunAtStartup}"/>
                </ui:CardControl>
                <ui:CardControl>
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Text="Add to Pouchy from Explorer" Style="{StaticResource CardTitle}"/>
                            <TextBlock Text="Adds &#x201C;Add to Pouchy&#x201D; to the right-click menu of files and folders, and Pouchy to &#x201C;Send to&#x201D;. On Windows 11 they're under &#x201C;Show more options&#x201D;. Turn this off before deleting Pouchy." Style="{StaticResource CardDescription}"/>
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ui:ToggleSwitch IsChecked="{Binding ExplorerMenu}"/>
                </ui:CardControl>
                <ui:CardControl>
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Text="Clear pouch on startup" Style="{StaticResource CardTitle}"/>
                            <TextBlock Text="Start with empty shelves (pinned items stay) instead of restoring the last session." Style="{StaticResource CardDescription}"/>
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ui:ToggleSwitch IsChecked="{Binding ClearOnStartup}"/>
                </ui:CardControl>
                <ui:CardControl>
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Text="Remove old items" Style="{StaticResource CardTitle}"/>
                            <TextBlock Text="Unpinned items older than this leave the pouch on their own. Pinned items always stay." Style="{StaticResource CardDescription}"/>
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ComboBox Width="140" ItemsSource="{Binding AutoClearOptions}" DisplayMemberPath="Value" SelectedValuePath="Key" SelectedValue="{Binding AutoClear}"/>
                </ui:CardControl>
                <ui:CardControl>
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Text="Fetch link titles and icons" Style="{StaticResource CardTitle}"/>
                            <TextBlock Text="When you drop a web address, Pouchy loads the page once to show its title and icon." Style="{StaticResource CardDescription}"/>
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ui:ToggleSwitch IsChecked="{Binding FetchLinkPreviews}"/>
                </ui:CardControl>

                <!-- Clipboard history -->
                <TextBlock Text="Clipboard history" Style="{StaticResource SectionHeader}"/>
                <ui:CardControl>
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Text="Keep everything I copy" Style="{StaticResource CardTitle}"/>
                            <TextBlock Text="Adds a Clipboard shelf that collects text, links, images and files as you copy them. Copies from password managers are skipped. Off by default." Style="{StaticResource CardDescription}"/>
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ui:ToggleSwitch IsChecked="{Binding ClipboardHistory}"/>
                </ui:CardControl>
                <ui:CardControl IsEnabled="{Binding ClipboardHistory}">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}">
                                <Run Text="Keep the last"/>
                                <Run Text="{Binding ClipboardHistoryLimit, Mode=OneWay}"/>
                                <Run Text="copies"/>
                            </TextBlock>
                            <TextBlock Text="Older ones are removed, unless you pin them." Style="{StaticResource CardDescription}"/>
                        </StackPanel>
                    </ui:CardControl.Header>
                    <Slider Width="180" Minimum="10" Maximum="200" TickFrequency="10" IsSnapToTickEnabled="True" Value="{Binding ClipboardHistoryLimit}"/>
                </ui:CardControl>

                <!-- Drop actions -->
                <TextBlock Text="Drop actions" Style="{StaticResource SectionHeader}"/>
                <ui:CardControl>
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Text="Show actions while dragging in" Style="{StaticResource CardTitle}"/>
                            <TextBlock Text="Drag files over the pouch and tiles like Zip or Convert to PNG appear. Drop on a tile to run it instead of adding the files." Style="{StaticResource CardDescription}"/>
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ui:ToggleSwitch IsChecked="{Binding ShowDropActions}"/>
                </ui:CardControl>
                <ItemsControl ItemsSource="{Binding ActionToggles}" IsEnabled="{Binding ShowDropActions}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ActionToggle}">
                            <ui:CardControl>
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource CardTitle}"/>
                                        <TextBlock Text="{Binding Description}" Style="{StaticResource CardDescription}"/>
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <ui:ToggleSwitch IsChecked="{Binding IsEnabled}"/>
                            </ui:CardControl>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Style="{StaticResource CardDescription}" Margin="2,4,0,8"
                           Text="Add your own actions: put a PowerShell, batch or Python script (or an .exe) in the actions folder. It gets the file paths as arguments, and any file path it prints is added to the pouch."/>
                <WrapPanel Margin="0,0,0,4">
                    <ui:Button Content="Open actions folder" Icon="{ui:SymbolIcon FolderOpen24}" Margin="0,0,8,8" Command="{Binding OpenActionsFolderCommand}"/>
                    <ui:Button Content="How scripts work" Icon="{ui:SymbolIcon Document24}" Margin="0,0,8,8"
                               Command="{Binding OpenLinkCommand}" CommandParameter="https://github.com/editorrylix/Pouchy/blob/main/docs/ACTIONS.md"/>
                </WrapPanel>

                <!-- Sounds -->
                <TextBlock Text="Sounds" Style="{StaticResource SectionHeader}"/>
                <ui:CardControl>
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Text="Sound pack" Style="{StaticResource CardTitle}"/>
                            <TextBlock Text="Little sounds when the pouch opens, takes something, or lets it go. Custom plays open.wav, add.wav, out.wav and remove.wav from the sounds folder." Style="{StaticResource CardDescription}"/>
                        </StackPanel>
                    </ui:CardControl.Header>
                    <StackPanel Orientation="Horizontal">
                        <ui:Button Icon="{ui:SymbolIcon Play24}" Margin="0,0,8,0" ToolTip="Play" Command="{Binding PreviewSoundCommand}"/>
                        <ComboBox Width="120" ItemsSource="{Binding SoundPackOptions}" SelectedItem="{Binding SoundPack}"/>
                    </StackPanel>
                </ui:CardControl>
                <ui:CardControl>
                    <ui:CardControl.Header>
                        <TextBlock Style="{StaticResource CardTitle}">
                            <Run Text="Volume:"/>
                            <Run Text="{Binding SoundVolume, Mode=OneWay, StringFormat={}{0:P0}}"/>
                        </TextBlock>
                    </ui:CardControl.Header>
                    <Slider Width="180" Minimum="0.1" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True" Value="{Binding SoundVolume}"/>
                </ui:CardControl>
                <ui:Button Content="Open sounds folder" Icon="{ui:SymbolIcon FolderOpen24}" Margin="0,0,0,4" Command="{Binding OpenSoundsFolderCommand}"/>

                <!-- Triggers -->
                <TextBlock Text="Triggers" Style="{StaticResource SectionHeader}"/>
                <ui:CardControl>
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Text="Shake to open" Style="{StaticResource CardTitle}"/>
                            <TextBlock Text="Wiggle the mouse left and right while dragging." Style="{StaticResource CardDescription}"/>
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ui:ToggleSwitch IsChecked="{Binding ShakeEnabled}"/>
                </ui:CardControl>
                <ui:CardControl IsEnabled="{Binding ShakeEnabled}">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}">
                                <Run Text="Shake distance:"/>
                                <Run Text="{Binding ShakeMinDistance, Mode=OneWay}"/><Run Text=" px"/>
                            </TextBlock>
                            <TextBlock Text="Lower is more sensitive. Raise it if the pouch opens by accident." Style="{StaticResource CardDescription}"/>
                        </StackPanel>
                    </ui:CardControl.Header>
                    <Slider Width="180" Minimum="10" Maximum="80" TickFrequency="5" IsSnapToTickEnabled="True"
                            Value="{Binding ShakeMinDistance}"/>
                </ui:CardControl>
                <ui:CardControl IsEnabled="{Binding ShakeEnabled}">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}">
                                <Run Text="Direction changes:"/>
                                <Run Text="{Binding ShakeReversals, Mode=OneWay}"/>
                            </TextBlock>
                            <TextBlock Text="How many back-and-forth movements count as a shake." Style="{StaticResource CardDescription}"/>
                        </StackPanel>
                    </ui:CardControl.Header>
                    <Slider Width="180" Minimum="2" Maximum="8" TickFrequency="1" IsSnapToTickEnabled="True"
                            Value="{Binding ShakeReversals}"/>
                </ui:CardControl>
                <ui:CardControl>
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Text="Bump the screen edge" Style="{StaticResource CardTitle}"/>
                            <TextBlock Text="Hit the left or right edge of the screen twice while dragging." Style="{StaticResource CardDescription}"/>
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ui:ToggleSwitch IsChecked="{Binding EdgeBumpEnabled}"/>
                </ui:CardControl>
                <ui:CardControl>
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Text="Hold a key while dragging" Style="{StaticResource CardTitle}"/>
                            <TextBlock Text="Note: Ctrl, Shift and Alt also change copy/move/link in Explorer." Style="{StaticResource CardDescription}"/>
                        </StackPanel>
                    </ui:CardControl.Header>
                    <StackPanel Orientation="Horizontal">
                        <ComboBox Width="110" Margin="0,0,12,0" ItemsSource="{Binding ModifierOptions}" SelectedItem="{Binding ModifierDragKey}"
                                  IsEnabled="{Binding ModifierDragEnabled}"/>
                        <ui:ToggleSwitch IsChecked="{Binding ModifierDragEnabled}"/>
                    </StackPanel>
                </ui:CardControl>
                <ui:CardControl>
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Text="Drag detection" Style="{StaticResource CardTitle}"/>
                            <TextBlock Text="{Binding DragDetectionDescription}" Style="{StaticResource CardDescription}"/>
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ComboBox Width="130" ItemsSource="{Binding DragDetectionOptions}" SelectedItem="{Binding DragDetection}"/>
                </ui:CardControl>

                <!-- Hotkey -->
                <TextBlock Text="Hotkey" Style="{StaticResource SectionHeader}"/>
                <ui:CardControl>
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Text="Show / hide pouch" Style="{StaticResource CardTitle}"/>
                            <TextBlock Text="Click the box and press a new key combination." Style="{StaticResource CardDescription}"/>
                            <TextBlock Text="{Binding HotkeyError}" Foreground="#FF6B6B" FontSize="11.5" TextWrapping="Wrap" Margin="0,4,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HotkeyError}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </ui:CardControl.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBox Width="150" Margin="0,0,12,0" IsReadOnly="True" IsReadOnlyCaretVisible="False"
                                 Text="{Binding HotkeyText, Mode=OneWay}" IsEnabled="{Binding HotkeyEnabled}"
                                 PreviewKeyDown="HotkeyBox_PreviewKeyDown" ToolTip="Click, then press a key combination"/>
                        <ui:ToggleSwitch IsChecked="{Binding HotkeyEnabled}"/>
                    </StackPanel>
                </ui:CardControl>
                <ui:CardControl>
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Text="Screenshot to pouch" Style="{StaticResource CardTitle}"/>
                            <TextBlock Text="Opens Windows' screen snip. What you capture lands in the pouch." Style="{StaticResource CardDescription}"/>
                            <TextBlock Text="{Binding ScreenshotHotkeyError}" Foreground="#FF6B6B" FontSize="11.5" TextWrapping="Wrap" Margin="0,4,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ScreenshotHotkeyError}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </ui:CardControl.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBox Width="150" Margin="0,0,12,0" IsReadOnly="True" IsReadOnlyCaretVisible="False" Tag="Screenshot"
                                 Text="{Binding ScreenshotHotkeyText, Mode=OneWay}" IsEnabled="{Binding ScreenshotHotkeyEnabled}"
                                 PreviewKeyDown="HotkeyBox_PreviewKeyDown" ToolTip="Click, then press a key combination"/>
                        <ui:ToggleSwitch IsChecked="{Binding ScreenshotHotkeyEnabled}"/>
                    </StackPanel>
                </ui:CardControl>

                <!-- Suppression -->
                <TextBlock Text="When not to open" Style="{StaticResource SectionHeader}"/>
                <ui:CardControl>
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Text="Ignore fullscreen apps" Style="{StaticResource CardTitle}"/>
                            <TextBlock Text="Don't open over games, videos or presentations." Style="{StaticResource CardDescription}"/>
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ui:ToggleSwitch IsChecked="{Binding SuppressInFullscreen}"/>
                </ui:CardControl>
                <Border Padding="16" CornerRadius="6" Margin="0,0,0,4"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Ignored apps" Style="{StaticResource CardTitle}"/>
                        <TextBlock Text="One program name per line, e.g. photoshop.exe. Saved when you leave the box."
                                   Style="{StaticResource CardDescription}" Margin="0,2,0,8"/>
                        <TextBox Text="{Binding BlacklistText}" AcceptsReturn="True" TextWrapping="NoWrap"
                                 MinHeight="90" MaxHeight="180" VerticalScrollBarVisibility="Auto" FontFamily="Consolas"/>
                    </StackPanel>
                </Border>

                <!-- About -->
                <TextBlock Text="About" Style="{StaticResource SectionHeader}"/>
                <Border Padding="16" CornerRadius="6" Margin="0,0,0,4"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Image Source="pack://application:,,,/Pouchy;component/Assets/pouchy-256.png" Width="52" Height="52" Margin="0,0,14,0"
                               VerticalAlignment="Top" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Pouchy" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <TextBlock Text="{Binding VersionText}" Style="{StaticResource CardDescription}"/>
                            <TextBlock Text="{Binding UpdateStatus}" Style="{StaticResource CardDescription}" Margin="0,6,0,0"/>
                            <WrapPanel Margin="0,10,0,0">
                                <ui:Button Content="{Binding InstallUpdateText}" Icon="{ui:SymbolIcon ArrowDownload24}" Margin="0,0,8,8"
                                           Appearance="Primary" Command="{Binding InstallUpdateCommand}"
                                           Visibility="{Binding HasAvailableUpdate, Converter={StaticResource BoolToVisibility}}"/>
                                <ui:Button Content="Check for updates" Icon="{ui:SymbolIcon ArrowSync24}" Margin="0,0,8,8"
                                           Command="{Binding CheckNowCommand}"/>
                                <ui:Button Content="What's new" Icon="{ui:SymbolIcon Sparkle24}" Margin="0,0,8,8"
                                           Command="{Binding OpenLinkCommand}" CommandParameter="https://github.com/editorrylix/Pouchy/releases"/>
                                <ui:Button Content="Report a bug" Icon="{ui:SymbolIcon Bug24}" Margin="0,0,8,8"
                                           Command="{Binding OpenLinkCommand}" CommandParameter="https://github.com/editorrylix/Pouchy/issues/new/choose"/>
                                <ui:Button Content="GitHub" Icon="{ui:SymbolIcon Code24}" Margin="0,0,8,8"
                                           Command="{Binding OpenLinkCommand}" CommandParameter="https://github.com/editorrylix/Pouchy"/>
                                <ui:Button Content="Privacy policy" Icon="{ui:SymbolIcon ShieldCheckmark24}" Margin="0,0,8,8"
                                           Command="{Binding OpenLinkCommand}" CommandParameter="https://github.com/editorrylix/Pouchy/blob/main/PRIVACY.md"/>
                            </WrapPanel>
                        </StackPanel>
                    </Grid>
                </Border>
                <ui:CardControl>
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Text="Check for updates automatically" Style="{StaticResource CardTitle}"/>
                            <TextBlock Text="About once a day Pouchy asks GitHub for the latest release. Nothing else is sent." Style="{StaticResource CardDescription}"/>
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ui:ToggleSwitch IsChecked="{Binding CheckForUpdates}"/>
                </ui:CardControl>

                <!-- Advanced -->
                <TextBlock Text="Advanced" Style="{StaticResource SectionHeader}"/>
                <StackPanel Orientation="Horizontal">
                    <ui:Button Content="Open data folder" Icon="{ui:SymbolIcon Folder24}" Margin="0,0,8,0" Command="{Binding OpenDataFolderCommand}"/>
                    <ui:Button Content="Open log" Icon="{ui:SymbolIcon DocumentText24}" Command="{Binding OpenLogCommand}"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</ui:FluentWindow>
