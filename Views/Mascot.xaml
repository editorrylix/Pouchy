<UserControl x:Class="Pouchy.Views.Mascot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="64" Height="64">
    <!--
        Pouchy the mascot: a little pouch with a face. Drawn on a 100×100 canvas and scaled.
        The body takes the theme's accent colour; moods swap the eyes and mouth (see Mascot.xaml.cs).
    -->
    <Viewbox Stretch="Uniform">
        <Canvas x:Name="Root" Width="100" Height="100" RenderTransformOrigin="0.5,0.95">
            <Canvas.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="Squash" ScaleX="1" ScaleY="1"/>
                    <RotateTransform x:Name="Tilt" Angle="0"/>
                    <TranslateTransform x:Name="Hop" Y="0"/>
                </TransformGroup>
            </Canvas.RenderTransform>

            <!-- Ground shadow -->
            <Ellipse x:Name="Shadow" Canvas.Left="26" Canvas.Top="92" Width="48" Height="7" Fill="#33000000"/>

            <!-- Feet -->
            <Ellipse Canvas.Left="28" Canvas.Top="85" Width="17" Height="11" Fill="{DynamicResource Pouch.Accent}"/>
            <Ellipse Canvas.Left="55" Canvas.Top="85" Width="17" Height="11" Fill="{DynamicResource Pouch.Accent}"/>
            <Ellipse Canvas.Left="28" Canvas.Top="85" Width="17" Height="11" Fill="#40000000"/>
            <Ellipse Canvas.Left="55" Canvas.Top="85" Width="17" Height="11" Fill="#40000000"/>

            <!-- Body -->
            <Rectangle Canvas.Left="13" Canvas.Top="32" Width="74" Height="60" RadiusX="26" RadiusY="26" Fill="{DynamicResource Pouch.Accent}"/>
            <Rectangle Canvas.Left="13" Canvas.Top="32" Width="74" Height="60" RadiusX="26" RadiusY="26">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0.3,0" EndPoint="0.7,1">
                        <GradientStop Color="#40FFFFFF" Offset="0"/>
                        <GradientStop Color="#00FFFFFF" Offset="0.55"/>
                        <GradientStop Color="#26000000" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <!-- Pouch opening (the lip) with a little pull tab -->
            <Rectangle Canvas.Left="7" Canvas.Top="21" Width="86" Height="22" RadiusX="11" RadiusY="11" Fill="{DynamicResource Pouch.Accent}"/>
            <Rectangle Canvas.Left="7" Canvas.Top="21" Width="86" Height="22" RadiusX="11" RadiusY="11" Fill="#73FFFFFF"/>
            <Rectangle Canvas.Left="44" Canvas.Top="14" Width="12" Height="11" RadiusX="4" RadiusY="4" Fill="{DynamicResource Pouch.Accent}"/>
            <Rectangle Canvas.Left="44" Canvas.Top="14" Width="12" Height="11" RadiusX="4" RadiusY="4" Fill="#99FFFFFF"/>

            <!-- Cheeks -->
            <Ellipse Canvas.Left="22" Canvas.Top="63" Width="13" Height="7" Fill="#8CFF7AA8"/>
            <Ellipse Canvas.Left="65" Canvas.Top="63" Width="13" Height="7" Fill="#8CFF7AA8"/>

            <!-- Eyes: open (idle/excited) -->
            <Canvas x:Name="OpenEyes">
                <Canvas x:Name="LeftEye" Canvas.Left="33" Canvas.Top="51" Width="10" Height="12" RenderTransformOrigin="0.5,0.5">
                    <Canvas.RenderTransform>
                        <ScaleTransform x:Name="LeftBlink" ScaleX="1" ScaleY="1"/>
                    </Canvas.RenderTransform>
                    <Ellipse Width="10" Height="12" Fill="#2A2240"/>
                    <Ellipse Canvas.Left="5.2" Canvas.Top="2" Width="3.4" Height="3.4" Fill="White"/>
                </Canvas>
                <Canvas x:Name="RightEye" Canvas.Left="57" Canvas.Top="51" Width="10" Height="12" RenderTransformOrigin="0.5,0.5">
                    <Canvas.RenderTransform>
                        <ScaleTransform x:Name="RightBlink" ScaleX="1" ScaleY="1"/>
                    </Canvas.RenderTransform>
                    <Ellipse Width="10" Height="12" Fill="#2A2240"/>
                    <Ellipse Canvas.Left="5.2" Canvas.Top="2" Width="3.4" Height="3.4" Fill="White"/>
                </Canvas>
            </Canvas>

            <!-- Eyes: happy ^ ^ -->
            <Canvas x:Name="HappyEyes" Visibility="Collapsed">
                <Path Data="M32,59 Q38,51 44,59" Stroke="#2A2240" StrokeThickness="3.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                <Path Data="M56,59 Q62,51 68,59" Stroke="#2A2240" StrokeThickness="3.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            </Canvas>

            <!-- Mouths -->
            <Path x:Name="SmileMouth" Data="M45,67 Q50,72 55,67" Stroke="#2A2240" StrokeThickness="2.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            <Path x:Name="BigSmileMouth" Data="M42,65 Q50,76 58,65 Z" Fill="#2A2240" Visibility="Collapsed"/>
            <Canvas x:Name="OpenMouth" Visibility="Collapsed">
                <Ellipse Canvas.Left="44" Canvas.Top="64" Width="12" Height="13" Fill="#2A2240"/>
                <Ellipse Canvas.Left="46.5" Canvas.Top="71" Width="7" Height="5" Fill="#FF7AA8"/>
            </Canvas>
            <Path x:Name="FlatMouth" Data="M45,69 Q50,67 55,69" Stroke="#2A2240" StrokeThickness="2.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed"/>

            <!-- Puzzled: a little question mark -->
            <TextBlock x:Name="QuestionMark" Canvas.Left="82" Canvas.Top="4" Text="?" FontSize="22" FontWeight="Bold"
                       Foreground="{DynamicResource Pouch.Accent}" Visibility="Collapsed"/>

            <!-- Excited: sparkles -->
            <Canvas x:Name="Sparkles" Visibility="Collapsed">
                <Path Data="M8,10 L10,15 L15,17 L10,19 L8,24 L6,19 L1,17 L6,15 Z" Fill="{DynamicResource Pouch.Accent}"/>
                <Path Data="M90,6 L91.5,10 L95.5,11.5 L91.5,13 L90,17 L88.5,13 L84.5,11.5 L88.5,10 Z" Fill="{DynamicResource Pouch.Accent}"/>
            </Canvas>
        </Canvas>
    </Viewbox>
</UserControl>
