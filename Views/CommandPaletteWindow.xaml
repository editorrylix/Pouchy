<Window x:Class="Pouchy.Views.CommandPaletteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:views="clr-namespace:Pouchy.Views"
        Title="Pouchy command palette"
        Width="520" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        FontFamily="{DynamicResource Pouch.FontFamily}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        PreviewKeyDown="Window_PreviewKeyDown" Deactivated="Window_Deactivated">

    <!-- Same look as the pouch: every colour comes from the active theme. -->
    <Grid Margin="24">
        <Border CornerRadius="{DynamicResource Pouch.CornerRadius}" Background="{DynamicResource Pouch.MenuBackground}"
                BorderBrush="{DynamicResource Pouch.Border}" BorderThickness="1" Effect="{DynamicResource Pouch.Shadow}"/>
        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border CornerRadius="10" Background="{DynamicResource Pouch.Tile}" BorderBrush="{DynamicResource Pouch.Accent}" BorderThickness="1" Padding="10,0,10,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <ui:SymbolIcon Symbol="Flash24" FontSize="16" Foreground="{DynamicResource Pouch.Accent}" Margin="0,0,8,0"/>
                    <TextBox x:Name="QueryBox" Grid.Column="1" FontSize="14" Padding="0,10" Background="Transparent" BorderThickness="0"
                             Foreground="{DynamicResource Pouch.Text}" CaretBrush="{DynamicResource Pouch.Accent}"
                             SelectionBrush="{DynamicResource Pouch.Accent}" TextChanged="QueryBox_TextChanged">
                        <TextBox.Template>
                            <ControlTemplate TargetType="TextBox">
                                <Grid>
                                    <TextBlock x:Name="Placeholder" Text="Type a command, an item or a shelf…" FontSize="14"
                                               Foreground="{DynamicResource Pouch.TextMuted}" VerticalAlignment="Center"
                                               Visibility="Collapsed" IsHitTestVisible="False"/>
                                    <ScrollViewer x:Name="PART_ContentHost" Focusable="False" Padding="{TemplateBinding Padding}"/>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="Text" Value="">
                                        <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </TextBox.Template>
                    </TextBox>
                </Grid>
            </Border>

            <ListBox x:Name="Results" Grid.Row="1" Margin="0,8,0,0" MaxHeight="380" Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" FocusVisualStyle="{x:Null}"
                     MouseLeftButtonUp="Results_MouseLeftButtonUp">
                <ListBox.Template>
                    <ControlTemplate TargetType="ListBox">
                        <ScrollViewer Focusable="False">
                            <ItemsPresenter/>
                        </ScrollViewer>
                    </ControlTemplate>
                </ListBox.Template>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Row" CornerRadius="8" Padding="10,7" Background="Transparent">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource Pouch.TileHover}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource Pouch.AccentSoft}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type views:PaletteCommand}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid Width="22" Height="22" HorizontalAlignment="Left">
                                <ui:SymbolIcon x:Name="Glyph" Symbol="{Binding Icon}" FontSize="16" Foreground="{DynamicResource Pouch.TextSecondary}"/>
                                <Border x:Name="Thumb" CornerRadius="5" Visibility="Collapsed">
                                    <Border.Background>
                                        <ImageBrush ImageSource="{Binding Thumbnail}" Stretch="UniformToFill"/>
                                    </Border.Background>
                                </Border>
                            </Grid>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}" FontSize="12.5" Foreground="{DynamicResource Pouch.Text}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="SubtitleText" Text="{Binding Subtitle}" FontSize="10.5" Foreground="{DynamicResource Pouch.TextMuted}"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                                <TextBlock Text="{Binding Shortcut}" FontSize="10.5" Foreground="{DynamicResource Pouch.TextMuted}" Margin="0,0,8,0"/>
                                <Border CornerRadius="5" Padding="6,1,6,2" Background="{DynamicResource Pouch.Tile}">
                                    <TextBlock Text="{Binding Group}" FontSize="9.5" Foreground="{DynamicResource Pouch.TextSecondary}"/>
                                </Border>
                            </StackPanel>
                        </Grid>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding HasThumbnail}" Value="True">
                                <Setter TargetName="Thumb" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Glyph" Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Subtitle}" Value="{x:Null}">
                                <Setter TargetName="SubtitleText" Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Grid Grid.Row="2" Margin="6,8,6,0">
                <TextBlock x:Name="EmptyText" Text="Nothing matches. Try fewer letters." FontSize="11.5"
                           Foreground="{DynamicResource Pouch.TextMuted}" Visibility="Collapsed"/>
                <TextBlock HorizontalAlignment="Right" FontSize="10.5" Foreground="{DynamicResource Pouch.TextMuted}"
                           Text="↑↓ choose · Enter run · Esc close"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
