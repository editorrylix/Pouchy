<ui:FluentWindow x:Class="Pouchy.Views.ThemeEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vm="clr-namespace:Pouchy.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:ThemeEditorViewModel}"
        Title="Theme editor" Height="700" Width="520" MinWidth="440" MinHeight="400"
        WindowBackdropType="Mica" ExtendsContentIntoTitleBar="True" WindowCornerPreference="Round"
        WindowStartupLocation="CenterOwner"
        Icon="pack://application:,,,/Pouchy;component/Assets/pouchy.ico"
        Closing="Window_Closing">

    <ui:FluentWindow.Resources>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="2,18,0,8"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
        </Style>
        <Style x:Key="CardDescription" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
        </Style>
        <Style TargetType="ui:CardControl" BasedOn="{StaticResource {x:Type ui:CardControl}}">
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Theme editor"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20,0,20,16">
                <TextBlock Style="{StaticResource CardDescription}" Margin="2,4,0,0"
                           Text="Changes show in the pouch as you make them. Open the pouch next to this window to watch."/>

                <TextBlock Text="Basics" Style="{StaticResource SectionHeader}"/>
                <ui:CardControl>
                    <ui:CardControl.Header>
                        <TextBlock Text="Name" Style="{StaticResource CardTitle}"/>
                    </ui:CardControl.Header>
                    <ui:TextBox Width="200" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                </ui:CardControl>
                <ui:CardControl>
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Text="Menus and windows" Style="{StaticResource CardTitle}"/>
                            <TextBlock Text="Whether Settings and menus look dark or light with this theme." Style="{StaticResource CardDescription}"/>
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ComboBox Width="150" ItemsSource="{Binding Source={x:Static vm:ThemeEditorViewModel.BaseOptions}}" SelectedItem="{Binding Base}"/>
                </ui:CardControl>

                <TextBlock Text="Colours" Style="{StaticResource SectionHeader}"/>
                <ItemsControl ItemsSource="{Binding ColorFields}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ThemeColorField}">
                            <ui:CardControl>
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Label}" Style="{StaticResource CardTitle}"/>
                                        <TextBlock Text="{Binding Description}" Style="{StaticResource CardDescription}"/>
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <StackPanel Orientation="Horizontal">
                                    <ui:TextBox Width="104" Margin="0,0,8,0" FontFamily="Consolas" Text="{Binding Hex, UpdateSourceTrigger=PropertyChanged}"/>
                                    <Button Width="36" Height="32" Padding="0" Cursor="Hand" ToolTip="Pick a colour" Click="Swatch_Click">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                                        Background="{Binding Brush}"/>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </StackPanel>
                            </ui:CardControl>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ui:CardControl>
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Text="Gradient background" Style="{StaticResource CardTitle}"/>
                            <TextBlock Text="Off: the pouch uses only the top background colour." Style="{StaticResource CardDescription}"/>
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ui:ToggleSwitch IsChecked="{Binding UseGradient}"/>
                </ui:CardControl>
                <ui:CardControl>
                    <ui:CardControl.Header>
                        <TextBlock Style="{StaticResource CardTitle}">
                            <Run Text="Background opacity:"/>
                            <Run Text="{Binding BackgroundOpacity, Mode=OneWay, StringFormat={}{0:P0}}"/>
                        </TextBlock>
                    </ui:CardControl.Header>
                    <Slider Width="180" Minimum="0.3" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True" Value="{Binding BackgroundOpacity}"/>
                </ui:CardControl>

                <TextBlock Text="Shape and type" Style="{StaticResource SectionHeader}"/>
                <ui:CardControl>
                    <ui:CardControl.Header>
                        <TextBlock Style="{StaticResource CardTitle}">
                            <Run Text="Corner roundness:"/>
                            <Run Text="{Binding CornerRadius, Mode=OneWay, StringFormat={}{0:0}}"/>
                        </TextBlock>
                    </ui:CardControl.Header>
                    <Slider Width="180" Minimum="0" Maximum="30" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding CornerRadius}"/>
                </ui:CardControl>
                <ui:CardControl>
                    <ui:CardControl.Header>
                        <TextBlock Style="{StaticResource CardTitle}">
                            <Run Text="Tile roundness:"/>
                            <Run Text="{Binding TileCornerRadius, Mode=OneWay, StringFormat={}{0:0}}"/>
                        </TextBlock>
                    </ui:CardControl.Header>
                    <Slider Width="180" Minimum="0" Maximum="24" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding TileCornerRadius}"/>
                </ui:CardControl>
                <ui:CardControl>
                    <ui:CardControl.Header>
                        <TextBlock Style="{StaticResource CardTitle}">
                            <Run Text="Shadow:"/>
                            <Run Text="{Binding ShadowOpacity, Mode=OneWay, StringFormat={}{0:P0}}"/>
                        </TextBlock>
                    </ui:CardControl.Header>
                    <Slider Width="180" Minimum="0" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True" Value="{Binding ShadowOpacity}"/>
                </ui:CardControl>
                <ui:CardControl>
                    <ui:CardControl.Header>
                        <TextBlock Text="Font" Style="{StaticResource CardTitle}"/>
                    </ui:CardControl.Header>
                    <ComboBox Width="200" ItemsSource="{Binding FontOptions}" SelectedItem="{Binding FontFamily}" IsTextSearchEnabled="True"/>
                </ui:CardControl>
                <ui:CardControl>
                    <ui:CardControl.Header>
                        <TextBlock Text="Header font" Style="{StaticResource CardTitle}"/>
                    </ui:CardControl.Header>
                    <ComboBox Width="200" ItemsSource="{Binding FontOptions}" SelectedItem="{Binding HeaderFontFamily}" IsTextSearchEnabled="True"/>
                </ui:CardControl>
                <ui:CardControl>
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Text="Scanlines" Style="{StaticResource CardTitle}"/>
                            <TextBlock Text="Faint CRT-style lines over the pouch, like the Terminal theme." Style="{StaticResource CardDescription}"/>
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ui:ToggleSwitch IsChecked="{Binding Scanlines}"/>
                </ui:CardControl>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Padding="20,12" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
            <Grid>
                <ui:Button Content="Edit JSON" Icon="{ui:SymbolIcon Code24}" HorizontalAlignment="Left" Click="EditJson_Click"
                           ToolTip="Every theme setting, including light-mode colours, is in the JSON file."/>
                <ui:Button Content="Done" Appearance="Primary" HorizontalAlignment="Right" MinWidth="90" Click="Done_Click"/>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
