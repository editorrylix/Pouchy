<Window x:Class="Pouchy.Views.PouchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vm="clr-namespace:Pouchy.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:PouchViewModel}"
        Title="Pouchy"
        Width="360"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        AllowDrop="True"
        DragEnter="Window_DragEnter"
        DragOver="Window_DragOver"
        DragLeave="Window_DragLeave"
        Drop="Window_Drop"
        PreviewKeyDown="Window_PreviewKeyDown"
        Closing="Window_Closing"
        Focusable="True"
        ResizeMode="NoResize">

    <Window.Resources>
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid>
                            <Border Background="Transparent"/>
                            <Track x:Name="PART_Track" IsDirectionReversed="true">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#44FFFFFF" CornerRadius="3" Margin="1,0,1,0"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Borderless button with a hover background; shared by the header and item actions. -->
        <Style x:Key="FlatButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1AFFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid" Margin="30">

        <Border x:Name="MainContainer" CornerRadius="16" BorderThickness="1" Opacity="0" Padding="10,12,10,10"
                Background="#990A0A0C" CacheMode="BitmapCache" RenderTransformOrigin="0.5,0.5">
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#40FFFFFF" Offset="0"/>
                    <GradientStop Color="#10FFFFFF" Offset="1"/>
                </LinearGradientBrush>
            </Border.BorderBrush>
            <Border.Effect>
                <DropShadowEffect BlurRadius="35" ShadowDepth="8" Opacity="0.65" Color="#000000" />
            </Border.Effect>
            <Border.RenderTransform>
                <ScaleTransform x:Name="WindowScale" ScaleX="0.95" ScaleY="0.95"/>
            </Border.RenderTransform>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Grid.Row="0" Height="24" Margin="0,0,0,10" Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <TextBlock Text="POUCHY" FontSize="9.5" FontWeight="SemiBold" Foreground="#66FFFFFF" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="Clear All" FontSize="10" FontWeight="Medium" Foreground="#66FFFFFF" Padding="8,4" Margin="0,0,4,0"
                                Command="{Binding ClearCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource FlatButton}">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="Foreground" Value="#FF6961"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Style="{StaticResource FlatButton}" Padding="6" Click="CloseButton_Click" ToolTip="Hide">
                            <ui:SymbolIcon Symbol="Dismiss24" FontSize="12" Foreground="#888888"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Empty state -->
                <Grid Grid.Row="1" Height="120" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                    <Rectangle Stroke="#44FFFFFF" StrokeThickness="1" StrokeDashArray="4 4" RadiusX="10" RadiusY="10" RenderOptions.EdgeMode="Aliased"/>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <ui:SymbolIcon Symbol="Archive24" FontSize="28" Foreground="#555555" Margin="0,0,0,10"/>
                        <TextBlock Text="Drop files or links here" Foreground="#777777" FontSize="12" FontWeight="Medium"/>
                    </StackPanel>
                </Grid>

                <!-- Items -->
                <ListBox Grid.Row="1" x:Name="PouchItemsControl" ItemsSource="{Binding Items}"
                         Visibility="{Binding IsEmpty, Converter={StaticResource InverseBoolToVisibility}}"
                         MaxHeight="450" Background="Transparent" BorderThickness="0"
                         ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         HorizontalContentAlignment="Stretch" Margin="-4,0,-4,0">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Padding" Value="4"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border Background="{TemplateBinding Background}">
                                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,5" Height="42" CornerRadius="8" BorderThickness="1" Cursor="Hand"
                                    MouseLeftButtonDown="PouchItem_MouseLeftButtonDown"
                                    MouseLeftButtonUp="PouchItem_MouseLeftButtonUp"
                                    MouseMove="PouchItem_MouseMove">
                                <Border.Background>
                                    <SolidColorBrush Color="#14FFFFFF"/>
                                </Border.Background>
                                <Border.BorderBrush>
                                    <SolidColorBrush Color="#1AFFFFFF"/>
                                </Border.BorderBrush>
                                <Border.Triggers>
                                    <EventTrigger RoutedEvent="MouseEnter">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <ColorAnimation Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#24FFFFFF" Duration="0:0:0.2"/>
                                                <ColorAnimation Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)" To="#33FFFFFF" Duration="0:0:0.2"/>
                                                <DoubleAnimation Storyboard.TargetName="ActionPanel" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut"/>
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                    <EventTrigger RoutedEvent="MouseLeave">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <ColorAnimation Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#14FFFFFF" Duration="0:0:0.2"/>
                                                <ColorAnimation Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)" To="#1AFFFFFF" Duration="0:0:0.2"/>
                                                <DoubleAnimation Storyboard.TargetName="ActionPanel" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut"/>
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Border.Triggers>

                                <Grid Margin="6,2,6,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Icon (dimmed when the file is missing) -->
                                    <Border Grid.Column="0" Width="28" Height="28" CornerRadius="8" Background="#1FFFFFFF" ClipToBounds="True">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMissing}" Value="True">
                                                        <Setter Property="Opacity" Value="0.4"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Image Source="{Binding Icon}" Stretch="UniformToFill" Width="18" Height="18"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <ui:SymbolIcon Symbol="TextDescription24" FontSize="14" Foreground="#B0B0B0"
                                                           Visibility="{Binding Icon, Converter={StaticResource NullToVisibility}}"/>
                                        </Grid>
                                    </Border>

                                    <!-- Name and metadata -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                                        <TextBlock Text="{Binding DisplayName}" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="11.5"
                                                   FontWeight="Medium" Foreground="#F5F5F7" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Metadata}" FontSize="9.5" Margin="0,1,0,0" TextTrimming="CharacterEllipsis">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#80FFFFFF"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsMissing}" Value="True">
                                                            <Setter Property="Foreground" Value="#FF9F7A"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>

                                    <!-- Hover actions -->
                                    <StackPanel x:Name="ActionPanel" Grid.Column="2" Orientation="Horizontal" Opacity="0" VerticalAlignment="Center">
                                        <Button Style="{StaticResource FlatButton}" Padding="6" Margin="0,0,2,0" ToolTip="Copy to Clipboard"
                                                Command="{Binding DataContext.CopyCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}">
                                            <ui:SymbolIcon Symbol="Copy24" FontSize="13" Foreground="#D0D0D0"/>
                                        </Button>
                                        <Button Padding="6" ToolTip="Remove"
                                                Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource FlatButton}">
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#FF453A"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <ui:SymbolIcon Symbol="Delete24" FontSize="13" Foreground="#D0D0D0"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Drag All -->
                <Border Grid.Row="2" Background="#20FFFFFF" BorderBrush="#2AFFFFFF" BorderThickness="1" CornerRadius="8" Height="32" Margin="0,8,0,0"
                        Cursor="Hand" RenderTransformOrigin="0.5,0.5"
                        Visibility="{Binding HasMultipleItems, Converter={StaticResource BoolToVisibility}}"
                        MouseLeftButtonDown="DragAll_MouseLeftButtonDown" MouseMove="DragAll_MouseMove">
                    <Border.RenderTransform>
                        <ScaleTransform x:Name="PillScale" ScaleX="1" ScaleY="1"/>
                    </Border.RenderTransform>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE700;" FontSize="11" Foreground="#FFFFFF" Margin="0,2,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding DragAllText}" FontSize="11" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                    </StackPanel>
                    <Border.Triggers>
                        <EventTrigger RoutedEvent="MouseEnter">
                            <BeginStoryboard>
                                <Storyboard>
                                    <ColorAnimation Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#30FFFFFF" Duration="0:0:0.2"/>
                                    <DoubleAnimation Storyboard.TargetName="PillScale" Storyboard.TargetProperty="ScaleX" To="1.01" Duration="0:0:0.2"/>
                                    <DoubleAnimation Storyboard.TargetName="PillScale" Storyboard.TargetProperty="ScaleY" To="1.01" Duration="0:0:0.2"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                        <EventTrigger RoutedEvent="MouseLeave">
                            <BeginStoryboard>
                                <Storyboard>
                                    <ColorAnimation Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#20FFFFFF" Duration="0:0:0.2"/>
                                    <DoubleAnimation Storyboard.TargetName="PillScale" Storyboard.TargetProperty="ScaleX" To="1.0" Duration="0:0:0.2"/>
                                    <DoubleAnimation Storyboard.TargetName="PillScale" Storyboard.TargetProperty="ScaleY" To="1.0" Duration="0:0:0.2"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Border.Triggers>
                </Border>
            </Grid>
        </Border>

        <!-- Edge tabs shown while docked -->
        <Border x:Name="EdgeTabLeft" Background="#D1161618" CornerRadius="0,4,4,0" Width="12" Height="80"
                HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="Collapsed"
                MouseEnter="EdgeTab_MouseEnter">
            <ui:SymbolIcon Symbol="ChevronRight24" FontSize="10" Foreground="#88FFFFFF"/>
        </Border>

        <Border x:Name="EdgeTabRight" Background="#D1161618" CornerRadius="4,0,0,4" Width="12" Height="80"
                HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed"
                MouseEnter="EdgeTab_MouseEnter">
            <ui:SymbolIcon Symbol="ChevronLeft24" FontSize="10" Foreground="#88FFFFFF"/>
        </Border>

    </Grid>
</Window>
